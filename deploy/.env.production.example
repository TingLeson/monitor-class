# ============================================================================
# ClassWatch 生产环境变量模板 —— 任务书 §62 / §63 / §77（Phase 11）
#
# 用法：
#   cp deploy/.env.production.example deploy/.env.production
#   # 逐项替换 CHANGE_ME / example.com，然后：
#   docker compose --env-file deploy/.env.production -f deploy/docker-compose.prod.yml up -d --build
#
# ⚠️ 三条铁律
#   1) 本文件（*.example）永远只放**占位值**，可以提交。
#      deploy/.env.production 里会有真实密钥与域名，**绝不能提交**。
#      根 .gitignore 已经忽略了 `deploy/.env.production`（可验证：
#      git check-ignore -v deploy/.env.production）。这一行不要删——
#      它是"手一抖 git add -A 就把生产密钥提交上去"的唯一一道门。
#      本文件（*.example）则是唯一可以存在于仓库里的版本。
#   2) 只有三个地方需要写"真实值"：域名、邮箱、密钥。其余保持默认即可。
#   3) 值里如果出现 `$`，必须写成 `$$`（docker compose 会用 `$` 做变量插值）。
#      密码里请避免 `@ : / ? # &` 等 URL 保留字符：POSTGRES_PASSWORD 会被拼进
#      DATABASE_URL，未转义的保留字符会直接导致"服务连不上数据库"。
# ============================================================================

# ============================================================================
# 一、域名与 TLS
# ============================================================================

# 三个前端入口的域名（§5：三套独立 Web 入口，不做单页分角色）。
# 安全含义：这三个域名会出现在 CORS 白名单与 Cookie 的作用域判断里；
# 写错的表现是"某个入口登录后立刻失效"，且不会报 CORS 错误（同源反代下）。
STUDENT_HOST=student.example.com
TEACHER_HOST=teacher.example.com
ADMIN_HOST=admin.example.com

# API 入口域名。它同时承担两件事：
#   1) LiveKit Cloud 的 webhook 回调地址（https://<API_HOST>/internal/livekit/webhook）；
#   2) 运维排障时绕过前端直打 API 的入口。
API_HOST=api.example.com

# 媒体面域名。**用 LiveKit Cloud 时留空**（TURN/TLS 由 LiveKit Cloud 提供，
# 不需要自建 coturn，也不需要 rtc.<domain>）。
# 只有自建 LiveKit 时才填，并且必须同时打开 deploy/Caddyfile 文末被注释的站点块。
RTC_HOST=

# ACME（Let's Encrypt）账户邮箱：**必须写真实可收信的地址**。
# 安全含义：它不参与业务，只用于证书到期提醒与账户找回。写成假邮箱的后果不是
# 报错，而是证书到期时没有任何人收到通知 —— 证书过期 = 四个入口同时不可用。
ACME_EMAIL=CHANGE_ME_ops@example.com

# ============================================================================
# 二、镜像与版本（回滚的抓手）
# ============================================================================

# API 镜像的**不可变**标签。允许的两种做法：
#   a) 服务器上构建：docker compose ... build api，标签写 classwatch-api:0.11.0；
#   b) CI 构建并推送到镜像仓库：registry.example.com/classwatch/api:0.11.0（推荐）。
# 安全含义：永远不要用 latest。回滚 = 把这个值改回上一个标签，
# 用 latest 的话"回滚"到底回到哪个二进制是不可知的。
API_IMAGE=classwatch-api:0.11.0

# 三个 SPA 的构建产物镜像（由 deploy/docker/web.Dockerfile 构建，一次性容器
# web-dist 把产物发布到卷里）。同样只用不可变标签。
WEB_IMAGE=classwatch-web:0.11.0

# 写进 /api/v1/meta 与启动日志的版本/提交号：排障时用来确认"线上跑的到底是哪个构建"。
APP_VERSION=0.11.0
APP_COMMIT=CHANGE_ME_git_sha

# SPA 构建所用的 Node 基础镜像（.nvmrc 为 26）。只在服务器上构建时才用得到。
NODE_IMAGE=node:26-alpine

# ============================================================================
# 三、PostgreSQL（唯一 Source of Truth，不对外暴露端口）
# ============================================================================

POSTGRES_USER=classwatch
# ⚠️ 必须改。这是唯一能读出全部课堂数据的凭据。
# 生成建议：openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# 避免使用 @ : / ? # & 等 URL 保留字符（见文件头说明）。
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=classwatch

# 连接池：与 PostgreSQL 的 max_connections 是同一个预算的两半。
# 20~30 学生的课堂是"短事务、低并发写"，默认值足够；调大前先确认
# 实例内存（每个 PostgreSQL 连接约占 5~10MB 常驻）。
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ============================================================================
# 四、Redis（会话索引 + 限流计数器，不对外暴露端口）
# ============================================================================

# ⚠️ 必须设置。虽然是内网，但同一宿主机上的任何其它容器都能连到它；
# 拿到它就能读/写会话状态与限流计数器（可用来"洗掉"限流）。
# 生成建议：openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DB=0

# ============================================================================
# 五、网络分段与可信代理（限流是否有效的总开关）
# ============================================================================

# Caddy 在 app 网络上的固定地址，必须与 deploy/docker-compose.prod.yml 里
# app 网络的网段一致（默认 172.31.0.0/24）。
CADDY_APP_IP=172.31.0.2

# 可信反向代理列表（CIDR，逗号分隔）。
# 默认留空 = 由 CADDY_APP_IP 派生为 <CADDY_APP_IP>/32，这是本拓扑下的正确值。
#
# 为什么这一项配错后果严重（两个方向都会坏）：
#   - 配成空/不匹配 → API 只看到 TCP 对端（Caddy 容器）的地址，
#     全站共用一个限流桶：一个学生在登录页刷新几次，全校都会收到 429；
#     访问日志与会话表里的 ip 列也会全部记录成代理地址，审计失去意义。
#   - 配得过宽（0.0.0.0/0 或整个 172.16.0.0/12）→ 任何能连到 API 的进程都可以
#     伪造 X-Forwarded-For。客户端轮换这个头就能给自己无限刷新的限流桶，
#     登录爆破从"每分钟 10 次"变成"无限次"。
# 前置 CDN/WAF（Cloudflare 等）时才需要显式覆盖，并且必须同时改 Caddyfile 里
# X-Forwarded-For 的取值来源（见 deploy/Caddyfile 的 api_proxy 注释）。
TRUSTED_PROXIES=

# 三个前端的 https 来源白名单（逗号分隔，禁止 *，禁止带路径）。
# 安全含义：这是"允许携带 Cookie 的跨源调用方"的完整清单。
# 生产同源反代下通常不触发跨源请求，但一旦前端改成直连 api.<domain>，
# 或在浏览器里做跨域调试，这份白名单就是唯一的门。
CORS_ALLOWED_ORIGINS=https://student.example.com,https://teacher.example.com,https://admin.example.com

# ============================================================================
# 六、会话与 Cookie（HTTPS 下的身份边界）
# ============================================================================

# 会话 Cookie 名的前缀：实际名字是 {前缀}_{role}（student/teacher/admin），
# 因为三个入口同属一个 registrable domain，同名 Cookie 会互相踢下线。
SESSION_COOKIE_NAME=classwatch_session

# 会话有效期。课堂场景下 24h 意味着"学生第二天不用重新输账号"，
# 但也意味着共享电脑上的会话能存活一天 —— 机房场景请调小（如 8h）。
SESSION_TTL=24h

# last_seen_at 的写入节流间隔（可观测性用途，避免每请求一次写）。
SESSION_IDLE_TOUCH_INTERVAL=5m

# ⚠️ 注意：SESSION_COOKIE_SECURE 由 compose 写死为 true，这里**不需要**也无法覆盖。
# 原因：在 http 上发送带 Secure 的 Cookie 会被浏览器直接丢弃，
# 所以"生产误发非 Secure 会话 Cookie"就是把会话暴露给同网络监听者的经典事故。
#
# ⚠️ SameSite 固定在代码里（Lax），本文件无法配置。
# 取舍：student/teacher/admin 与 api 是同一个 registrable domain 的兄弟子域，
# 浏览器把"同站不同子域"视为 same-site，因此 Lax 在跨子域请求上照样会带上 Cookie。
# 只有当前端与 API 处于**完全不同的站点**（例如嵌入第三方平台）时才需要
# SameSite=None; Secure —— 那要改 services/api/internal/httpapi/auth.go 并
# 接受"必须做到严格 CSRF 防护"的代价。详见 docs/development/deployment.md。

# 密码强度下限（仅约束 ADMIN/TEACHER；学生免密是明确业务规则，不是遗漏）。
PASSWORD_MIN_LENGTH=12

# ============================================================================
# 七、限流阈值（防爆破，也是"误伤"的来源）
# ============================================================================

# 单 IP 每分钟登录尝试次数。校园网出口 NAT 下几百个学生可能共用一个出口 IP，
# 这个值太小会让整个学校互相误伤；太大则爆破成本降低。
RATE_LIMIT_LOGIN_PER_MINUTE=10

# 单**账号**每 10 分钟失败登录次数：即使攻击者换 IP，这一层仍然生效。
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_10MIN=5

# 单 IP 每分钟普通 API 请求数。老师端监督墙会周期性拉取状态，
# 但这个数字是按"单 IP"计的 —— 又一次提醒：NAT 校园网下它不是"单学生"。
RATE_LIMIT_API_PER_MINUTE=300

# ============================================================================
# 八、媒体面（LiveKit Cloud）
# ============================================================================
# 真实密钥只写在这里（deploy/.env.production，必须 gitignore），
# 永远不会进前端产物：浏览器拿到的是一次性的、短期的、限定房间的 Token。

# 下发给浏览器的信令地址。**必须 wss://**。写错协议的表现是"页面一直连接中"。
LIVEKIT_URL=wss://CHANGE_ME_project.livekit.cloud
# 后端调用 LiveKit RoomService/Twirp 的地址。**必须 https://**。
# 写错的表现是 /readyz 里 livekit 项不是 ok（后端探活失败）。
LIVEKIT_API_URL=https://CHANGE_ME_project.livekit.cloud

# LiveKit API Key。安全含义：它只是"标识"，真正的凭据是下面的 secret。
LIVEKIT_API_KEY=CHANGE_ME_livekit_api_key
# ⚠️ LiveKit API Secret：**这是整个系统里权限最高的密钥**。
# 持有它就能为任意房间签发任意身份的 Token（等于拿到媒体面的 root）。
# 因此：只注入后端容器；绝不写进前端、日志、截图或工单；
# 一旦怀疑泄露，在 LiveKit 控制台立即轮换（轮换后重启 api 容器）。
LIVEKIT_API_SECRET=CHANGE_ME_livekit_api_secret

# 媒体 Token 有效期。默认 2h 的理由：课堂中途断网重连必须能用手里的 Token，
# 而"刷新 Token"这个动作本身可能正处在断网期。
# 安全含义：调大 = 一个泄露的 Token 可被滥用的时间更长；
# 调太小 = 长课堂中途失效（表现为学生突然被踢出且无法自动恢复）。
LIVEKIT_TOKEN_TTL=2h

# 自建 LiveKit 时的补充（用 LiveKit Cloud 时全部保持注释）：
#   RTC_HOST=rtc.example.com
#   LIVEKIT_URL=wss://rtc.example.com
#   LIVEKIT_API_URL=https://rtc.example.com
# 并且必须打开 deploy/Caddyfile 文末的 rtc 站点块、打开 livekit 配置里的
# rtc.use_external_ip、放行 50000-60000/udp 与 5349/tcp（TURN/TLS）。
# 细节与验证方法见 docs/development/deployment.md。

# ============================================================================
# 九、入口加固与可观测性
# ============================================================================

# Caddy 允许的最大请求体，**单位是字节**（不要写 "1MB"）。
# 同一个值会同时注入 Caddy（request_body max_size）与 API（http.MaxBytesReader），
# 两端一致才不会出现"代理放行、应用拒绝"这类要在两个日志里对时间的错位问题。
# 媒体流走 WebRTC 不经过这里，因此 1 MiB 对"登录表单 + LiveKit webhook"是宽裕的。
# 安全含义：它是抵御"用一个巨大请求把内存/带宽吃满"的第一道闸门；
# 调大之前请先想清楚哪个接口真的需要大 body（当前没有）。
# 合法范围由 API 强制：1 ~ 67108864（64 MiB）。
HTTP_MAX_BODY_BYTES=1048576

# 日志级别：debug / info / warn / error。生产用 info。
# 日志**格式**由 APP_ENV=production 决定为 JSON（代码里写死，无 LOG_FORMAT 变量），
# 这样日志采集端可以按字段检索，而不必用正则去啃文本行。
# 安全含义：debug 级别可能把请求细节写进日志，生产不要开。
LOG_LEVEL=info

# ── 指标（Prometheus）──────────────────────────────────────────────────────
# API 在 /metrics 上暴露 Prometheus 文本格式指标（Phase 11 引入）。
#
# ⚠️ 安全边界：**/metrics 故意不经过 Caddy 暴露到公网**（deploy/Caddyfile 里没有
#    它的路由）。指标里包含路由名、依赖状态与课堂规模，属于内部信息；而且它没有
#    鉴权（为的是让 Prometheus 不带凭据也能抓）。
#    正确做法是"让采集器进到内网"：
#      - 采集器与 api 同处 app/data 网络（推荐：把 Prometheus 也放进这份 compose，或
#        与它共享 docker 网络）；
#      - 或者 SSH 隧道：ssh -L 9090:localhost:8080 ops@<server>，再在本地抓
#        http://127.0.0.1:9090/metrics；
#      - 或者在 Caddyfile 的 api 站点里加 `@monitor remote_ip <采集器 IP>` 只对
#        该来源放行 /metrics（见 Caddyfile 里探针那段注释的同款写法）。
#    一行自检命令（不需要额外工具）：
#      docker compose --env-file deploy/.env.production -f deploy/docker-compose.prod.yml \
#        exec -T api wget -qO- http://127.0.0.1:8080/metrics | head
#
# 会话/在线人数的刷新间隔（巡检任务的周期）。调小 = 指标更实时但数据库写入更频繁。
METRICS_SESSION_REFRESH_INTERVAL=15s

# ── API 的 HTTP 超时（可选项，默认值已适合单机部署）────────────────────────
# 只在遇到具体问题（慢客户端占满连接、或某个慢接口被写超时切断）时才调整。
# 注意 HTTP_READ_HEADER_TIMEOUT 不得大于 HTTP_READ_TIMEOUT（API 会拒绝启动）。
# 这些超时**不会**切断 WebSocket：长连接由业务层心跳管理。
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=10s

# 容器日志轮转（docker json-file 驱动**默认不轮转**，
# 一个日志死循环可以在几小时内把磁盘写满，随后数据库写入失败、全线不可用）。
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# ============================================================================
# 十、资源上限（按"1 老师 + 20~30 学生"的量级估算，见 docs/development/deployment.md）
# ============================================================================
# 安全/稳定性含义：这些是**上限**不是预留，作用是把"某个服务内存泄漏"限制在
# 一个容器内，而不是让整台机器 OOM 把 PostgreSQL 一起杀掉。
# 注意：流量成本（尤其是 TURN 中继）不在这里 —— 用 LiveKit Cloud 时它按流量计费。

API_CPU_LIMIT=2.0
API_MEM_LIMIT=1g
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEM_LIMIT=1g
REDIS_CPU_LIMIT=1.0
REDIS_MEM_LIMIT=512m
CADDY_CPU_LIMIT=1.0
CADDY_MEM_LIMIT=256m

# ============================================================================
# 十一、备份（deploy/scripts/backup-db.sh 使用）
# ============================================================================
# 备份目录（宿主机路径）。WHY 单独一个变量：备份必须落在与数据卷**不同的**
# 物理磁盘/挂载点上，否则磁盘损坏时数据与备份一起消失。
# 该脚本从同一个 .env.production 读取 POSTGRES_USER/DB 等，
# 因此请用 `env $(grep -v '^#' ...)` 或 `set -a; . ./...` 方式加载，见脚本用法。
BACKUP_DIR=/var/backups/classwatch
# 保留份数：N=7 大约覆盖一周（配合 cron 每日一次）。
BACKUP_RETENTION=7
