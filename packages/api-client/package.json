{
  "name": "@classwatch/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "ClassWatch 前端统一 API 客户端：Cookie 会话、统一错误体解析、请求追踪",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@classwatch/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
