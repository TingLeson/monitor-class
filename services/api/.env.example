# ============================================================================
# ClassWatch API 服务环境变量模板（Phase 11 新增项）
#
# 本文件是 **services/api 自己的** 变量清单：只包含这个二进制读取的键。
# 仓库根的 .env.example 是 docker-compose 使用的完整模板，两者需要保持一致；
# 根文件由部署负责人维护，这里的每一行都应当在根 .env.example 中同步出现。
#
# 使用方式：make init 会把根 .env.example 复制为 .env；本文件用于查阅与补齐。
# 所有值均为**开发占位值**，生产环境必须由部署平台注入。
# ============================================================================

# ---------- 应用与日志（§59）----------
APP_ENV=development
API_ADDR=:8080
# debug | info | warn | error
LOG_LEVEL=info
# text | json | 留空 = 跟随 APP_ENV（生产 JSON，其余 text）。
# 为什么可配：staging 想验证生产的日志管道，本地排障又想要人类可读的格式。
LOG_FORMAT=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
STARTUP_REQUIRE_DEPENDENCIES=true
DB_AUTO_MIGRATE=false

# ---------- HTTP 服务器加固（§63/§77）----------
# 请求体上限（字节）。本项目最大的合法 body 是课堂名单导入（几 KB），
# 1 MiB 足够大又足以让"发 4 GiB body 撑爆堆"不可能发生。
HTTP_MAX_BODY_BYTES=1048576
# 读请求行+头部的超时：slowloris 的正面防线（在任何 handler 运行之前生效）。
HTTP_READ_HEADER_TIMEOUT=5s
# 读整个请求（头+体）的超时。
HTTP_READ_TIMEOUT=15s
# 写响应的超时。**不会掐断 WebSocket**：handler hijack 后 net/http 会清空连接
# deadline，且 hub 自己为每一帧设置写上限（见 internal/realtime/timeout_test.go）。
HTTP_WRITE_TIMEOUT=30s
# keep-alive 空闲连接的最长存活时间，避免被遗弃的标签页长期占用 fd。
HTTP_IDLE_TIMEOUT=60s
# 优雅关闭的总预算：停止接受新连接 → 排空在途请求 → 关 socket → 关连接池。
# 必须小于编排器的 SIGKILL 宽限期（通常 30s）。
HTTP_SHUTDOWN_TIMEOUT=10s
# 收到 SIGTERM 后、关闭 listener 之前仍然继续服务的时间：这段时间里新请求得到
# 503 + Retry-After（而不是被 http.Server.Shutdown 静默丢弃），同时负载均衡器的
# readiness 探针把本实例摘除。0 = 立即停止监听（仅当没有任何流量路由到这里时正确）。
HTTP_DRAIN_DELAY=2s

# ---------- 指标（§59/§77）----------
# /metrics 的采样型 gauge（会话状态普查、连接池、私密讲话）刷新间隔。
# 必须显著大于抓取间隔，否则缓慢变化的总体量看起来会抖动。
METRICS_SESSION_REFRESH_INTERVAL=15s

# ---------- 限流（§2.2/§63/§77）----------
# 窗口全部可配：阈值是策略，策略要能在不发版的情况下调整。
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW=10m
RATE_LIMIT_API_WINDOW=1m
# 下列端点共用这个窗口。
RATE_LIMIT_ENDPOINT_WINDOW=1m

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_10MIN=5
RATE_LIMIT_API_PER_MINUTE=300
# 私密讲话（POST/DELETE）：人工节奏，30/窗口已远高于真人操作。
RATE_LIMIT_PRIVATE_TALK=30
# 老师媒体 token：签发凭据，20/窗口。
RATE_LIMIT_MEDIA_TOKEN=20
# 学生进入课堂：一个 NAT 出口后面可能是一整间教室同时进入，因此默认宽松。
RATE_LIMIT_JOIN=60
# WebSocket 握手：一个教室同时打开控制台约 31 次握手，故与 join 同量级；
# 它限制的是重连风暴，不是正常连接。
RATE_LIMIT_WS_HANDSHAKE=60
# 每个客户端地址**同时**允许的 WebSocket 连接数（握手速率之外的第二道闸）。
WS_MAX_CONNECTIONS_PER_IP=64
#   默认 64（原 16）：一间教室通常只有一个 NAT 出口，按 IP 卡 16 条等于"第 17 个学生上不了课"
#   （Phase 12 实测 20 并发 → 16 成功 / 4 个 429）。见 docs/development/performance-test.md §9.4。

# ---------- 可信代理（§63）----------
# 逗号分隔的 CIDR（或单个 IP）。留空 = 完全不信任 X-Forwarded-For / X-Real-IP /
# X-Forwarded-Proto，一律使用 TCP 对端地址（限流/审计/HTTPS 判定都以它为准）。
# 部署在 Caddy/Nginx 之后时**必须**填真实代理网段：填窄了只有一个共享限流桶，
# 填宽了客户端就能伪造 IP 绕过限流。
TRUSTED_PROXIES=

# ---------- 数据库 / Redis / LiveKit（既有项，此处仅列出键名）----------
DATABASE_URL=postgres://classwatch:classwatch_dev_password@localhost:5432/classwatch?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_HEALTH_CHECK_PERIOD=1m
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=classwatch_dev_livekit_secret_32b
LIVEKIT_TOKEN_TTL=2h
SESSION_COOKIE_NAME=classwatch_session
SESSION_TTL=24h
SESSION_IDLE_TOUCH_INTERVAL=5m
SESSION_COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=12
