# ============================================================================
# ClassWatch 本地开发环境变量模板
#
# 使用方式：make init   （把本文件复制为 .env，.env 已被 .gitignore 忽略）
#
# 本文件中的值全部是“本地开发专用”的占位值，仅用于让 docker-compose 在本机
# 跑起来。生产环境的所有密钥必须由部署平台注入，禁止照搬这里任何值。
# ============================================================================

# ---------- API 服务 ----------
APP_ENV=development
API_ADDR=:8080
LOG_LEVEL=info
# 宿主机发布的 API 端口（容器内始终是 8080）。
# 默认 8090 而不是 8080：开发机上 8080 常被其它项目占用，端口冲突会让 make dev 直接失败。
# 修改这里时**必须**同步修改 VITE_API_PROXY_TARGET，否则前端代理会打到错误的后端。
API_PORT=8090
# CORS allowlist：只有这些来源可以携带 Cookie 调用 API。
# 生产环境必须替换为 student./teacher./admin. 三个真实域名。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# 前端 dev server 的代理目标（三个 app 共用仓库根的 .env，避免端口配置漂移）。
VITE_API_PROXY_TARGET=http://localhost:8090
# 启动时是否自动执行数据库 migration。生产环境必须保持 false，改为发布流程中显式执行。
# （本地 compose 用一次性 migrate 服务执行迁移，因此这里通常是 false。）
DB_AUTO_MIGRATE=false
# 依赖连不上时是否拒绝启动。PostgreSQL 是唯一 Source of Truth，
# 默认 true：宁可启动失败，也不要带病对外报告健康。
STARTUP_REQUIRE_DEPENDENCIES=true

# ---------- PostgreSQL ----------
POSTGRES_USER=classwatch
POSTGRES_PASSWORD=classwatch_dev_password
POSTGRES_DB=classwatch
POSTGRES_PORT=5432
# 宿主机直连串（make dev-api / go run / go test 使用）。
# 容器内的 api 服务会由 docker-compose 覆盖为 postgres:5432。
DATABASE_URL=postgres://classwatch:classwatch_dev_password@localhost:5432/classwatch?sslmode=disable
# 集成测试专用库。默认**故意注释掉**：
#   未设置时 `go test ./...` / `make test-api` 会自动跳过需要真实数据库的用例，
#   保证没有数据库的机器上单测依然全绿；
#   `make test-integration` 会创建 classwatch_test 库并显式传入该变量。
# TEST_DATABASE_URL=postgres://classwatch:classwatch_dev_password@localhost:5432/classwatch_test?sslmode=disable

# ---------- Redis ----------
# 默认 6380：6379 是 Redis 的默认端口，开发机上经常已被其它项目占用。
REDIS_PORT=6380
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# ---------- LiveKit ----------
# 开发用 key/secret：livekit 容器通过 LIVEKIT_KEYS 环境变量读取，不写入仓库配置文件。
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=classwatch_dev_livekit_secret_32b
# 浏览器（学生/老师）连接的地址，会作为 media-token 响应的一部分下发给前端。
LIVEKIT_URL=ws://localhost:7880
# 后端调用 LiveKit Server API 的地址（容器内由 docker-compose 覆盖为 http://livekit:7880）。
LIVEKIT_API_URL=http://localhost:7880

# ---------- Session ----------
SESSION_COOKIE_NAME=classwatch_session
SESSION_TTL=24h
# 本地是 http://localhost，无法使用 Secure Cookie；生产必须为 true。
SESSION_COOKIE_SECURE=false
